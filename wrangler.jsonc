{
	// Server-rendered Astro on Cloudflare Workers.
	//
	// Unlike my-blog, this one has an adapter and a server entrypoint: every voice turn
	// is a POST that calls a model, so there is nothing to prerender.
	//
	// `main` points at the adapter's own entrypoint, not at dist — the build output does
	// not exist when this file is read. `assets` and `compatibility_date` are filled in
	// by Astro, so they are deliberately absent.
	//
	// GEMINI_API_KEY is a secret, not a var. Set it with:
	//   npx wrangler secret put GEMINI_API_KEY
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "suara",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Astro sets this for the build, but wrangler's own commands (`types`, `deploy`)
	// require it in the file, so it is explicit.
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],
	// The transcript channel. Cross-checks the audio model rather than driving decisions;
	// without this binding the turn still works, just uncorroborated.
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"SUARA_PROVIDER": "gemini",
		"SUARA_MODEL": "gemini-3.5-flash-lite"
	}
}
