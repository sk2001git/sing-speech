	"title": {
		"short": "FRS amount",
		"full": "Your Full Retirement Sum"
	},
	"summary": {
		"text": "Your FRS depends on the year you turn 55 and remains the same for life.",
		"quote_refs": [
			"q1"
		]
	},
	"details": [
		{
			"heading": "FRS for 2015 to 2021",
			"body": "If you turned 55 in 2015 or 2016, your FRS was $161,000. In 2017, it was $166,000. In 2018, $171,000. In 2019, $176,000. In 2020, $181,000. In 2021, $186,000.",
			"quote_refs": [
				"q2"
			]
		},
		{
			"heading": "FRS for 2022 to 2027",
			"body": "If you turned 55 in 2022, your FRS was $192,000. In 2023, $198,800. In 2024, $205,800. In 2025, $213,000. In 2026, $220,400. In 2027, $228,200.",
			"quote_refs": [
				"q3"
			]
		},
		{
			"heading": "Before July 1960",
			"body": "If your date of birth is before 1 July 1960, you can view the past FRS.",
			"quote_refs": [
				"q4"
			]
		}
	],
