# Which provider handles a voice turn. The registry in src/lib/providers/index.ts
# rejects an unknown value at startup rather than silently selecting nothing.
SUARA_PROVIDER=gemini

# Model within that provider. Prices for each are recorded in the provider file with the
# date they were checked — the cost harness reads them, so a stale value here makes every
# projection wrong.
SUARA_MODEL=gemini-3.5-flash-lite

# In production this is a Worker secret, not a var:
#   npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=
OPENROUTER_API_KEY=sk-or-...

# The corroborating transcript channel. none by default: nothing is attached unless you
# name it here. workers-ai (Whisper) also needs the AI binding in wrangler.jsonc; gemini
# uses GEMINI_API_KEY. Known values: none, workers-ai, gemini.
SUARA_TRANSCRIBER=none

# How the page hears a turn: gemini (record, then POST — the original flow) or openai
# (WebRTC to OpenAI Realtime). ?mode=gemini or ?mode=openai overrides this per page load.
SUARA_MODE=gemini

# OpenAI Realtime model. gpt-realtime-2.1-mini is the cheaper option. Prices are recorded
# in src/lib/providers/openai-realtime.ts with the date checked.
SUARA_OPENAI_MODEL=gpt-realtime-2.1
# Model that writes a card from a crawled official page when no entry answers the
# question. A gpt- name goes to OpenAI, anything else to OpenRouter. Default is the one
# measured fastest at writing a usable card first time (scripts/kb/bench-write.ts).
SUARA_WRITE_MODEL=gpt-6-luna

# Only needed for SUARA_MODE=openai. A Worker secret in production:
#   npx wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=

# true shows the unverified hospital sample flow outside the dev server.
SUARA_DEMO=false
