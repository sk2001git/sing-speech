---
import Suara from '../components/kb/Suara.tsx';
import Voice from '../components/Voice.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { runtimeEnv } from '../lib/env';
import { resolveMode } from '../lib/mode';
import { resolveRoute, ROUTE_LABEL } from '../lib/routes';

/**
 * client:load, because talking is the only thing this page does. Deferring hydration
 * would mean the microphone button is dead for the first moment it is on screen.
 */
export const prerender = false;

const env = await runtimeEnv();

// The knowledge base is the product. `?legacy=1` keeps the six-intent readback app
// reachable for comparison until build step 11 removes it.
const legacy = Astro.url.searchParams.get('legacy') === '1';

// `?route=gemini` or `?route=openai-ws` overrides SUARA_ROUTE for review.
const route = resolveRoute(Astro.url.searchParams.get('route'), env.SUARA_ROUTE);
const mode = resolveMode(Astro.url.searchParams.get('mode'), env.SUARA_MODE);
// Demo builds also name the vendor route at the foot, for review; users never see it.
const demo = import.meta.env.DEV || env.SUARA_DEMO === 'true';
---

<BaseLayout title="Suara">
	{legacy ? <Voice client:load mode={mode} demo={demo} /> : <Suara client:load route={route} routeLabel={demo ? ROUTE_LABEL[route] : undefined} />}
</BaseLayout>
