---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- user-scalable is left on. Pinch-zoom is how many older users read a phone,
		     and disabling it to keep a layout tidy takes that away. -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
